<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/helpLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/helpTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Help &amp; User Guide"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- FAQ 1: Navigation -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. How to Navigate the App"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Use the top action bar or bottom navigation to switch between your Main Dashboard and Settings. On the Dashboard, you can view live broadcast announcements and your personal raffle ticket number."
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp" />

        <!-- FAQ 2: Profile Settings -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. Updating Profile &amp; Settings"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Navigate to Settings from the top bar. You can update your full name, email address, or set a new password. Tap 'Save Changes' to update your credentials directly in the online database."
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp" />

        <!-- FAQ 3: Logging Out -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3. Managing Your Session"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="To safely sign out of your account, tap the 'Log Out' button in Settings. Your local session will be cleared and you will be returned to the Login screen."
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp" />

        <!-- Support Contact Box -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Need Assistance?"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contact Support: support@capeitassist.co.za\nOperating Hours: Mon - Fri, 08:00 - 17:00"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/backFromHelpButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Settings" />

    </LinearLayout>
</ScrollView>